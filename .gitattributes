# ---------- 行尾规则 ----------
# 源码/文本统一 LF（Windows 检出时按需转 CRLF）
* text=auto

*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.s text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
Makefile text eol=lf

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# ---------- 二进制（不参与 diff/文本转换） ----------
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.gif binary
*.ico binary

# ---------- Git LFS：大二进制文件 ----------
# PCB/原理图/库（Altium 等 EDA，扩展名大小写按工具实际情况补充）
*.PcbDoc filter=lfs diff=lfs merge=lfs -text
*.pcbdoc filter=lfs diff=lfs merge=lfs -text
*.SchDoc filter=lfs diff=lfs merge=lfs -text
*.schdoc filter=lfs diff=lfs merge=lfs -text
*.PcbLib filter=lfs diff=lfs merge=lfs -text
*.pcblib filter=lfs diff=lfs merge=lfs -text
*.SchLib filter=lfs diff=lfs merge=lfs -text
*.schlib filter=lfs diff=lfs merge=lfs -text

# 3D/结构
